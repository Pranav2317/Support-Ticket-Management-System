PORT=5000
NODE_ENV=development

# Leave empty to use an auto-seeded in-memory MongoDB (dev only)
MONGODB_URI=
# MONGODB_URI=mongodb://localhost:27017/helpdesk

# Required in production - use a long random string
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Optional SMTP for email notifications (otherwise emails are logged to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Helpdesk <no-reply@helpdesk.local>

# Optional: override seeded demo admin credentials
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
